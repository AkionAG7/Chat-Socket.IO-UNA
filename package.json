{
  "name": "chat-socket-io-una",
  "version": "1.0.0",
  "description": "Aplicación de chat y calculadora de riesgos con Auth0, Azure Key Vault y Supabase",
  "main": "server.js",
  "keywords": ["chat", "socketio", "auth0", "azure", "supabase", "risk-calculator"],
  "author": "Equipo UNA Seguridad Informática",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.3",
    "express-openid-connect": "^2.19.2",
    "prom-client": "^15.1.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "@azure/identity": "^4.0.1",
    "@supabase/supabase-js": "^2.38.0",
    "pg": "^8.11.3"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "mocha",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "lint": "eslint . --ext .js --fix",
    "lint:ci": "eslint . --ext .js --max-warnings=0",
    "build": "echo \"No hay paso de compilación: OK\"",
    "build:image": "docker build -t chat-una:dev .",
    "run:container": "docker run --rm -p 3000:3000 chat-una:dev",
    "scan:image": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest --fail-on high chat-una:dev",
    "scan:image:fixed": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest --only-fixed --fail-on high chat-una:dev",
    "scan:image:sarif": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest -o sarif --fail-on high chat-una:dev > grype.sarif",
    "install:deps": "npm install",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "chai": "^4.3.10",
    "cypress": "^15.6.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jsdom": "^24.0.0",
    "mocha": "^10.8.2",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "ws": "8.17.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/chat-socket-io-una.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/chat-socket-io-una/issues"
  },
  "homepage": "https://chat-socket-io-una.onrender.com"
}