{
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-openid-connect": "^2.19.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1"
  },
  "scripts": {
    "start": "node server.js",
    "test": "mocha",
    "lint": "eslint . --ext .js --fix",
    "lint:ci": "eslint . --ext .js --max-warnings=0",
    "build": "echo \"No hay paso de compilación: OK\"",
    "build:image": "docker build -t chat-una:dev .",
    "run:container": "docker run --rm -p 3000:3000 chat-una:dev",
    "scan:image": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest --fail-on high chat-una:dev",
    "scan:image:fixed": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest --only-fixed --fail-on high chat-una:dev",
    "scan:image:sarif": "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock anchore/grype:latest -o sarif --fail-on high chat-una:dev > grype.sarif"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "chai": "^4.3.10",
    "cypress": "^15.6.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "jsdom": "^24.0.0",
    "mocha": "^10.8.2",
    "wait-on": "^9.0.1"
  },
  "overrides": {
    "ws": "8.17.1"
  }
}
